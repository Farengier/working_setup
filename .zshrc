# my git aliases
alias gb="git branch"
alias gpo="git push origin"
alias gl="git log --format='%C(yellow)%h%Creset %C(brightblack)%ad%Creset %C(yellow)[%an]%Creset%C(auto)%d%Creset %s' --date=short"
alias ud="urldecode.sh"

export PATH="$HOME/bin:$PATH"
#alias gch="git checkout $1:$1" // move to bin/gch